# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL connection string used by Prisma.
# Point this at your database, then run: bun run db:migrate && bun run auth:admin
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/velure?schema=public

# Optional comma-separated user ids that are always treated as admins.
ADMIN_USER_IDS=

# DigitalOcean Spaces. The SDK region stays us-east-1 internally;
# SPACES_REGION is the datacenter, for example sgp1 or nyc3.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=
# Optional. Defaults to https://<SPACES_REGION>.digitaloceanspaces.com
SPACES_ENDPOINT=
# Optional CDN origin, for example https://velure.sgp1.cdn.digitaloceanspaces.com
SPACES_CDN_ENDPOINT=

# WhatsApp number that receives cart orders (international format, digits only).
NEXT_PUBLIC_WHATSAPP_NUMBER=6281930854396

# Orders at or above this amount (whole Rupiah) ship free. Defaults to 500000.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=500000
